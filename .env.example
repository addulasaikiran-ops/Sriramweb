# Add deployment-specific variables here when needed.

# Optional Google Apps Script / email webhook endpoint for lead capture
LEAD_WEBHOOK_URL=

# Optional shared secret; the receiving webhook must validate x-lead-secret
LEADS_WEBHOOK_SECRET=

# Optional Google Analytics 4 measurement ID (example: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Optional canonical production origin override; defaults to the current Vercel site
NEXT_PUBLIC_SITE_URL=
