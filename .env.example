# Required for absolute canonical, Open Graph, JSON-LD, robots and sitemap URLs.
# Use the real production HTTPS origin; do not leave a placeholder in deployment.
NEXT_PUBLIC_SITE_URL=

# Optional lead capture endpoint: deploy a Google Apps Script web app that appends JSON to a Google Sheet.
# Configure the deployed web app URL in your hosting provider's environment settings.
GOOGLE_SHEETS_WEBHOOK_URL=
# Optional shared secret sent as the x-lead-secret header; validate it in the webhook if used.
LEADS_WEBHOOK_SECRET=

# Optional Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=
